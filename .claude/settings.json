{
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        "~/.codex/auth.json",
        "~/.codex*/**/auth.json"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.codex/auth.json)",
      "Read(~/.codex*/**/auth.json)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git * push*)",
      "Bash(Scripts/release.sh*)",
      "Bash(./Scripts/release.sh*)",
      "Bash(bash Scripts/release.sh*)",
      "Bash(sh Scripts/release.sh*)",
      "Bash(zsh Scripts/release.sh*)",
      "Bash(Scripts/install-local.sh*)",
      "Bash(./Scripts/install-local.sh*)",
      "Bash(bash Scripts/install-local.sh*)",
      "Bash(sh Scripts/install-local.sh*)",
      "Bash(zsh Scripts/install-local.sh*)",
      "Bash(gh release*)",
      "Bash(git worktree add*)",
      "Bash(git * worktree add*)",
      "Bash(git switch*)",
      "Bash(git * switch*)",
      "Bash(git checkout -b*)",
      "Bash(git * checkout -b*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" stop -- 'Scripts/check.sh'",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
