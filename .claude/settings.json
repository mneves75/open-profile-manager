{
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "~/.codex/auth.json",
        "~/.codex*/**/auth.json"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.codex/auth.json)",
      "Read(~/.codex*/**/auth.json)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(Scripts/release.sh*)",
      "Bash(Scripts/install-local.sh*)",
      "Bash(gh release*)",
      "Bash(git worktree add*)",
      "Bash(git switch*)",
      "Bash(git checkout -b*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.claude/hooks/claude-gate\" ]; then \"$HOME/.claude/hooks/claude-gate\" stop -- 'Scripts/check.sh'; elif [ -n \"$(git status --porcelain 2>/dev/null)\" ]; then Scripts/check.sh; fi",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
