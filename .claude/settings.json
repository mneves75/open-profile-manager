{
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        "~/.codex/auth.json",
        "~/.codex*/**/auth.json"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.codex/auth.json)",
      "Read(~/.codex*/**/auth.json)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git * push*)",
      "Bash(*Scripts/release.sh*)",
      "Bash(*Scripts/install-local.sh*)",
      "Bash(gh release*)",
      "Bash(git worktree*)",
      "Bash(git * worktree*)",
      "Bash(git switch*)",
      "Bash(git * switch*)",
      "Bash(git checkout*)",
      "Bash(git * checkout*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" stop -- 'Scripts/check.sh'",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
